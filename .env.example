# ------------------------------------------------------------------
# Example environment file. Copy to `.env` for local use.
# DO NOT put real secrets in `.env.example`. DO NOT commit `.env`.
# ------------------------------------------------------------------
# The site currently uses NO server-side secrets and NO tracking.
# These values are optional and only relevant if you later wire a
# hosted form endpoint instead of the built-in email-draft fallback.

# Optional: a form backend endpoint (e.g. a Cloudflare Worker or
# Formspree URL). Leave empty to keep the "Prepare Email Inquiry"
# email-draft fallback active.
PUBLIC_FORM_ENDPOINT=
