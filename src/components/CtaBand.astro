---
/**
 * CtaBand — reusable closing call-to-action used at the end of pages.
 */
import Icon from "./Icon.astro";

export interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "Have a project in mind?",
  text = "Tell me what you're trying to build or figure out. The first step is a short, no-pressure conversation.",
  primaryLabel = "Discuss Your Project",
  primaryHref = "/contact",
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="ctaband" data-reveal>
  <div class="container-narrow ctaband__inner">
    <h2 class="ctaband__title">{title}</h2>
    <p class="ctaband__text">{text}</p>
    <div class="btn-row ctaband__actions">
      <a href={primaryHref} class="btn btn--primary">
        {primaryLabel} <Icon name="arrow" size={18} />
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="btn btn--secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .ctaband {
    background: var(--c-ink);
    border-radius: var(--radius);
    margin-block: var(--space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }
  .ctaband::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 120% at 90% 0%, rgba(15, 118, 110, 0.35), transparent 60%);
    pointer-events: none;
  }
  .ctaband__inner { position: relative; text-align: center; padding-inline: 0; }
  .ctaband__title { color: #fff; margin-bottom: var(--space-3); }
  .ctaband__text { color: #d7dde4; margin: 0 auto var(--space-5); max-width: 52ch; }
  .ctaband__actions { justify-content: center; }
  .ctaband .btn--secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .ctaband .btn--secondary:hover {
    border-color: #fff;
    color: #fff;
  }
</style>
