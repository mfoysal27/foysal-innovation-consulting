---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { EXPERIENCE, EXPERIENCE_NOTE } from "../config/experience";
---

<BaseLayout
  title="Selected Experience"
  description="Selected prior research and R&D background that informs the consultancy — described from public, non-confidential information. Not consultancy client projects."
  canonicalPath="/experience"
>
  <section class="section--tight page-hero">
    <div class="container">
      <p class="eyebrow">Selected experience</p>
      <h1>Background that informs the work</h1>
      <p class="lead">
        A selection of the founder's previous research and employment. Each
        summary explains the problem, the founder's contribution, the
        technologies involved, and the expertise it demonstrates.
      </p>
      <aside class="xp-note" role="note">
        <p>{EXPERIENCE_NOTE}</p>
      </aside>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="xp-list">
        {EXPERIENCE.map((item, i) => (
          <article class="xp-item" data-reveal>
            <div class="xp-item__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
            <div class="xp-item__body">
              <span class="tag">{item.category}</span>
              <h2 class="xp-item__title">{item.title}</h2>

              <div class="xp-item__section">
                <h3>Problem</h3>
                <p>{item.problem}</p>
              </div>
              <div class="xp-item__section">
                <h3>Contribution</h3>
                <p>{item.contribution}</p>
              </div>
              <div class="xp-item__section">
                <h3>Demonstrates</h3>
                <p>{item.demonstrates}</p>
              </div>

              <div class="xp-item__tech">
                {item.technologies.map((t) => <span class="tag tag--soft">{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <CtaBand
      title="Looking for similar expertise on your project?"
      text="If any of this overlaps with what you're building, let's talk about how it applies to your situation."
      secondaryLabel="Explore Services"
      secondaryHref="/services"
    />
  </div>
</BaseLayout>

<style>
  .page-hero { padding-top: var(--space-7); }
  .page-hero h1 { margin-block: var(--space-3) var(--space-4); }
  .xp-note {
    margin-top: var(--space-5);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--c-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-5);
  }
  .xp-note p { margin: 0; font-size: 0.9rem; color: var(--c-ink-soft); max-width: none; }

  .xp-list { display: flex; flex-direction: column; gap: var(--space-6); }
  .xp-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .xp-item__index {
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-border-strong);
    line-height: 1;
  }
  .xp-item__title { margin-block: var(--space-3) var(--space-4); font-size: 1.5rem; }
  .xp-item__section { margin-bottom: var(--space-4); }
  .xp-item__section h3 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent-strong);
    margin-bottom: 0.3rem;
  }
  .xp-item__section p { margin: 0; color: var(--c-ink-soft); }
  .xp-item__tech { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .tag--soft {
    background: var(--c-bg-alt);
    color: var(--c-ink-soft);
    border-color: var(--c-border);
  }

  @media (max-width: 640px) {
    .xp-item { grid-template-columns: 1fr; gap: var(--space-3); padding: var(--space-5); }
    .xp-item__index { font-size: 1.4rem; }
  }
</style>
