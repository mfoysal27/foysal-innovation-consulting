---
/**
 * OfferCard — a productized starting offer. No invented pricing.
 */
import Icon from "./Icon.astro";
import type { Offer } from "../config/offers";

export interface Props {
  offer: Offer;
}
const { offer } = Astro.props;
---

<article class:list={["offer card card--hover", { "offer--featured": offer.featured }]} data-reveal>
  {offer.featured && <span class="offer__badge">Most requested</span>}
  <h3 class="offer__title">{offer.title}</h3>
  <p class="offer__tagline">{offer.tagline}</p>
  <p class="offer__desc">{offer.description}</p>
  <ul class="offer__list">
    {offer.includes.map((item) => (
      <li><Icon name="check" size={18} /> <span>{item}</span></li>
    ))}
  </ul>
  <div class="offer__foot">
    <a href={offer.cta.href} class="btn btn--primary offer__cta">{offer.cta.label}</a>
  </div>
</article>

<style>
  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    position: relative;
  }
  .offer--featured {
    border-color: var(--c-accent);
    box-shadow: var(--shadow);
  }
  .offer__badge {
    position: absolute;
    top: -12px;
    left: var(--space-6);
    background: var(--c-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
  }
  .offer__title { margin: 0; }
  .offer__tagline { color: var(--c-accent-strong); font-weight: 600; }
  .offer__desc { color: var(--c-ink-soft); }
  .offer__list {
    list-style: none;
    margin: var(--space-2) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .offer__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--c-ink-soft);
    font-size: 0.95rem;
  }
  .offer__list svg { color: var(--c-accent); flex: none; margin-top: 2px; }
  .offer__foot { margin-top: var(--space-3); }
  .offer__cta { width: 100%; justify-content: center; }
</style>
