---
/**
 * Footer — brand, navigation, verified links only, and the independence
 * notice. The direct-email link appears only when a contact email is set.
 */
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
import { SITE, NAV_LINKS, verifiedSocial, hasContactEmail } from "../config/site";
import { SERVICES } from "../config/services";

const year = new Date().getFullYear();
const social = verifiedSocial();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brandcol">
      <a href="/" class="site-footer__brand" aria-label={`${SITE.brandName} — home`}>
        <BrandMark variant="full" />
      </a>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <p class="site-footer__meta muted">
        {SITE.founderDisplayName}, {SITE.founderCredential} · {SITE.location}
      </p>
      {hasContactEmail() && (
        <a class="site-footer__email" href={`mailto:${SITE.contactEmail}`}>
          <Icon name="mail" size={18} /> {SITE.contactEmail}
        </a>
      )}
    </div>

    <nav class="site-footer__col" aria-label="Footer">
      <h2 class="site-footer__h">Explore</h2>
      <ul>
        {NAV_LINKS.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Services">
      <h2 class="site-footer__h">Services</h2>
      <ul>
        {SERVICES.map((s) => (
          <li><a href={`/services/${s.slug}`}>{s.title}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container">
    <hr class="divider" />
    <div class="site-footer__bottom">
      <p class="site-footer__independence muted">{SITE.independenceNotice}</p>
      <div class="site-footer__legal">
        {social.length > 0 && (
          <div class="site-footer__social">
            {social.map((s) => (
              <a href={s.url} rel="me noopener" target="_blank">{s.label}</a>
            ))}
          </div>
        )}
        <p class="muted">© {year} {SITE.brandName}. A working trade name of an independent consultancy.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-bg-alt);
    border-top: 1px solid var(--c-border);
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-9);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-7);
    margin-bottom: var(--space-6);
  }
  .site-footer__brand { display: inline-flex; margin-bottom: var(--space-4); }
  .site-footer__tagline {
    font-family: var(--font-head);
    font-size: 1.1rem;
    color: var(--c-ink);
    max-width: 34ch;
    margin-bottom: var(--space-3);
  }
  .site-footer__meta { font-size: 0.9rem; margin-bottom: var(--space-3); }
  .site-footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }
  .site-footer__h {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: var(--space-3);
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .site-footer__col a {
    color: var(--c-ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .site-footer__col a:hover { color: var(--c-accent-strong); }

  .site-footer__bottom {
    padding-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .site-footer__independence { font-size: 0.82rem; max-width: 80ch; }
  .site-footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.85rem;
  }
  .site-footer__social { display: flex; gap: var(--space-4); }

  @media (max-width: 760px) {
    .site-footer__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
